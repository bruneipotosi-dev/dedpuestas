# Copiá este archivo a .env y completá los valores reales. .env nunca se commitea.

# Postgres — usados por compose.yaml para crear la base y por Prisma para conectarse.
POSTGRES_USER=dedpuestas
POSTGRES_PASSWORD=<PASSWORD_LOCAL>
POSTGRES_DB=dedpuestas

# Cadena de conexión que usa Prisma. En local (fuera de Docker) el host es
# localhost; compose.yaml la sobreescribe con host "db" para el contenedor app.
DATABASE_URL="postgresql://dedpuestas:<PASSWORD_LOCAL>@localhost:5432/dedpuestas?schema=public"

# Firma de las cookies de sesión (sesiones propias, ver docs/adr/0003).
SESSION_SECRET=<GENERAR_CON_openssl_rand_-hex_32>

# Cloudflare Turnstile (anti-abuso en registro/login/apuestas).
TURNSTILE_SITE_KEY=<TURNSTILE_SITE_KEY>
TURNSTILE_SECRET_KEY=<TURNSTILE_SECRET_KEY>
